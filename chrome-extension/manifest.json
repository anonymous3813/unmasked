{
  "manifest_version": 3,
  "name": "Unmasked",
  "version": "1.0.0",
  "description": "Analyze product pages for hidden fine print.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["overlay.js", "content.js"]
    }
  ]
}
