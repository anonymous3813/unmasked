{
  "manifest_version": 3,
  "name": "Unmasked",
  "version": "1.0.0",
  "description": "Analyze product pages for hidden fine print.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["vendor/react.production.min.js", "vendor/react-dom.production.min.js", "src/chat-ui.js", "src/overlay.js", "src/content.js"]
    }
  ]
}
